# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# media & gallery assets (served remotely in production)
/public/gallery/

# misc
.DS_Store
*.pem

# debug & dev logs
*.log
*.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local tooling & preview cache
.freebuff/

# IDE & editors
.vscode/
.idea/
*.swp
*.swo

# Windows & OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

